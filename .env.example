# Stripe secret key. Use sk_test_... until launch, then sk_live_...
STRIPE_SECRET_KEY=sk_test_replace_me
# The $450 one-time Price you create in the Stripe Dashboard (see README)
STRIPE_PRICE_ID=price_replace_me
# Public address of the site, no trailing slash. Used for Stripe return links.
SITE_URL=http://localhost:3000
PORT=3000
# Optional. Defaults to 60.
ENROLLMENT_CAPACITY=60
# Set true only after club-details.json is complete and test checkout passes.
ENROLLMENT_OPEN=false
