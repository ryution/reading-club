# ---- Basics ----
# Public address, no trailing slash. Required in production (https).
SITE_URL=http://localhost:3000
PORT=3000
# Set to false to show "signups open soon" instead of the signup form.
ENROLLMENT_OPEN=true
# Where seat reservations are saved while Stripe is off.
# On Vercel: connect Upstash Redis (adds these two automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# On a normal server: a folder on disk.
DATA_DIR=./data

# ---- Member sign-in and email ----
# Long random string. Changing it signs everyone out.
LOGIN_SECRET=
# Resend key for confirmation and sign-in emails. Without it, emails are printed to the log.
RESEND_API_KEY=
MAIL_FROM=Reading Club <hello@nyphilosophy.org>
# Gets a short note for every new signup. Optional.
NOTIFY_EMAIL=
# Zoom links etc. as JSON (alternative to a private.json file). See private.example.json.
PRIVATE_JSON=

# ---- Stripe (leave empty for now) ----
# When all three are set, signups go to Stripe Checkout instead of reserving a seat.
STRIPE_SECRET_KEY=
MEMBER_PRICE_ID=
DROPIN_PRICE_ID=
# Optional: auto-apply a promo code for a list link, e.g. journal=promo_123
SOURCE_PROMOS=
# Optional: Stripe customer portal link for members to update a card or cancel.
BILLING_PORTAL_URL=
